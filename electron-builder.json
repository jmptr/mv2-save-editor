{
  "appId": "com.jmptr.mv2-save-editor",
  "productName": "MV2 Save Editor",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": ["dist/**", "package.json"],
  "win": {
    "target": "nsis",
    "icon": "build/icon.ico"
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "createStartMenuShortcut": true
  }
}
